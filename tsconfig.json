{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "widgets/**/*.tsx", "app.config.ts", "expo-env.d.ts"]
}

{
  "name": "lens-takip",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prebuild": "expo prebuild",
    "doctor": "npx expo-doctor",
    "verify": "npm run typecheck && npm test && npm run test:ui",
    "release:check": "node scripts/check-release.cjs",
    "eas-build-pre-install": "node scripts/eas-preinstall.cjs",
    "test:ui": "jest --runInBand",
    "store:pages": "node scripts/build-store-pages.cjs",
    "web": "expo export --platform web --output-dir dist-web && node scripts/serve-web.cjs",
    "web:dev": "expo start --web --localhost",
    "test:web": "node tests/web/smoke.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.2",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.1.0",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "fake-indexeddb": "^6.2.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "jsdom": "^26.1.0",
    "react-test-renderer": "^19.3.0",
    "typescript": "~5.9.3"
  }
}

<!-- Pastel card with a soft lower edge for depth (widgets cannot draw real elevation). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:top="3dp"><shape android:shape="rectangle"><corners android:radius="22dp" /><solid android:color="#2EC4425A" /></shape></item>
  <item android:bottom="3dp"><shape android:shape="rectangle"><corners android:radius="22dp" /><gradient android:angle="315" android:startColor="#FFF4F6" android:endColor="#FBDCE4" /><stroke android:width="1dp" android:color="#D9FFFFFF" /></shape></item>
</layer-list>

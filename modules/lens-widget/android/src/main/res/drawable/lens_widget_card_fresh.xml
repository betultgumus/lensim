<!-- Pastel card with a soft lower edge for depth (widgets cannot draw real elevation). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:top="3dp"><shape android:shape="rectangle"><corners android:radius="22dp" /><solid android:color="#2E3B6FC4" /></shape></item>
  <item android:bottom="3dp"><shape android:shape="rectangle"><corners android:radius="22dp" /><gradient android:angle="315" android:startColor="#F4F9FF" android:endColor="#DDEBFF" /><stroke android:width="1dp" android:color="#D9FFFFFF" /></shape></item>
</layer-list>

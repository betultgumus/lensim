<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/lens_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#F2EDFF">
  <TextView android:id="@+id/lens_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lens Takip" android:textSize="12sp" android:textStyle="bold" android:textColor="#7456C3" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/lens_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Merhaba" android:textSize="32sp" android:textStyle="bold" android:textColor="#28233A" />
      <TextView android:id="@+id/lens_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lens takibini başlat" android:textSize="12sp" android:textColor="#28233A" />
    </LinearLayout>
    <ImageView android:id="@+id/lens_mascot" android:layout_width="52dp" android:layout_height="52dp" android:importantForAccessibility="no" />
  </LinearLayout>
  <TextView android:id="@+id/lens_due" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Uygulamayı aç" android:textSize="11sp" android:textColor="#787286" />
  <ProgressBar android:id="@+id/lens_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:layout_marginTop="5dp" android:visibility="gone" />
  <TextView android:id="@+id/lens_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:visibility="gone" android:textColor="#28233A" />
  <TextView android:id="@+id/lens_stock" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:visibility="gone" android:textColor="#787286" />
</LinearLayout>

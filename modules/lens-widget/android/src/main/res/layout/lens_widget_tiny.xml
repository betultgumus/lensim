<?xml version="1.0" encoding="utf-8"?>
<!-- Lensim 1x1 widget: only the counter ("31/30", the total smaller). The background colour is the lens state. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/lens_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/lens_widget_tile_fresh" android:padding="10dp">
  <TextView android:id="@+id/lens_count" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:text="7/30" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="36sp" android:autoSizeStepGranularity="1sp" android:importantForAccessibility="no" />
</FrameLayout>
